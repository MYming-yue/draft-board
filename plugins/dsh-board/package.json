{
  "name": "dsh-board",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Local Draft Board workspace inside DeepSeek Harness",
  "license": "MIT",
  "main": "src/host.mjs",
  "files": ["src", "lib", "cordis.patch.yml", "README.md"],
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
